eng2sp = dict()
print(eng2sp)

eng2sp["one"] = "uno"
print(eng2sp)

eng2sp = {"one": "uno",
          "two": "dos",
          "three": "tres"}
print(eng2sp["two"])

#operador in
print("uno" in eng2sp)

#selecionar valore
valores = eng2sp.values()
print("one" in valores)


def  count_letters(s):
    d = dict()
    for c in s:
        if c not in d:
            d[c] = 1
        else:
            d[c] += 1
    return d
dict_contagem = count_letters("rafael bixa")
print(dict_contagem)



TUPLAS:
t = 'a', 'b', 'c', 'd', 'e'

print(t)

t1 = ('a',)
print(t1)

t = tuple("rafael bixa")
print(t)

t = ("R",) + t[1:]
print(t)

#atribuicao com tuplas

a = 5
b = 10
print(f"a:{a}, b: {b}")
